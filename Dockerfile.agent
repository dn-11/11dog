# Stage 1: Build 11dog-agent binary
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=1.0.0
ARG TARGETOS=linux
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w -X github.com/dn-11/11dog/internal/agent.Version=${VERSION}" \
    -o /out/11dog-agent ./cmd/agent

# Stage 2: Minimal agent runtime image
FROM alpine:3.21
LABEL org.opencontainers.image.source="https://github.com/dn-11/11dog"
LABEL org.opencontainers.image.description="11Dog - DN11 Network Diagnostic Edge Probe Agent"
RUN apk add --no-cache ca-certificates tzdata && mkdir -p /etc/11dog /opt/11dog
COPY deploy/certs/dn11-roots.crt /usr/local/share/ca-certificates/dn11-roots.crt
RUN update-ca-certificates
COPY --from=go-builder /out/11dog-agent /usr/local/bin/11dog-agent
ENTRYPOINT ["/usr/local/bin/11dog-agent"]
