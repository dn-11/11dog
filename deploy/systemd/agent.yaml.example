# 11Dog Edge Probe Agent (Direct NATS JetStream + Decentralized JWT/NKey .creds)
nats_addr: "nats://127.0.0.1:4222"
creds_file: "/etc/11dog/agent.creds"
stream_name: "DOG_TASKS"
max_concurrency: 8
heartbeat_interval_sec: 10

# Optional TLS settings (for tls:// or wss:// NATS endpoints)
tls_ca_file: ""
tls_insecure_skip_verify: false

capabilities:
  - ping
  - tcping
  - http
  - traceroute
  - dns
