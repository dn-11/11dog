http_listen_addr: ":8080"
# 托管供 /scripts/install.sh 下载的 Agent 二进制目录
agent_bin_dir: "./bin"
agent_download_base_url: ""

site_title: "11Dog - DN11 网络测速平台"
network_name: "DN11"

auth:
  admin_token: "change-me-dn11-admin-token"

db:
  # sqlite (单机轻量内置纯 Go) 或 postgres (多副本高可用)
  driver: "sqlite"
  dsn: "./data/11dog.db"

nats:
  # 外部 NATS JetStream 地址（支持 nats://, tls://, ws://, wss://）
  url: "nats://127.0.0.1:4222"
  # 对外展示给 Agent 安装脚本的 NATS 地址（留空则复用 url）
  public_url: ""
  stream_name: "DOG_TASKS"
  max_queue_per_node: 20
  task_ttl_sec: 60
  # 留空时首次启动自动生成 Operator/Account Seed 并持久化到数据库 settings 表；
  # 可运行 `11dog-server nats-config` 或在后台点击「导出 NATS 配置」生成 nats-server.conf
  operator_seed: ""
  account_seed: ""
  tls_ca_file: ""
  tls_insecure_skip_verify: false

limits:
  rate_limit_rpm: 180
  rate_limit_burst: 30
  max_target_len: 512
  default_timeout_ms: 15000
  max_timeout_ms: 60000
  per_node_dispatch_rps: 10
  task_history_ttl_sec: 1800
  allowed_cidrs: []
  denied_cidrs: []

dn11_registry:
  # 定时从 DN11 Registry 拉取并驻留内存，用于解析目标 IP / Traceroute 跳点的 ASN 与归属
  enabled: true
  url: "https://github.com/dn-11/registry/archive/HEAD.tar.gz"
  refresh_interval_sec: 1800

dn11_prefixes:
  - cidr: "172.16.0.0/16"
    asn: 4211110000
    owner: "DN11 Backbone"
    region: "DN11"
  - cidr: "fd00::/48"
    asn: 4211110000
    owner: "DN11 IPv6 Backbone"
    region: "DN11"
